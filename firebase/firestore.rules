rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true;
    }
    function validAnnouncement() {
      let data = request.resource.data;
      return data.keys().hasAll(['title', 'body', 'date', 'updatedAt'])
        && data.keys().hasOnly(['title', 'body', 'date', 'updatedAt'])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 160
        && data.body is string && data.body.size() > 0 && data.body.size() <= 8000
        && data.date is string && (data.date == '' || data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && data.updatedAt == request.time;
    }
    match /announcements/{id} {
      allow read: if true;
      allow create, update: if isAdmin() && validAnnouncement();
      allow delete: if isAdmin();
    }
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
